// Cloudflare: сайтът е статичен – качват се само файловете от dist/
// worker.js се включва само за видеата (отдаване на части за iPhone)
// Качване: npm run deploy
{
  "name": "airsoftwarzone",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "airsoftwarzone.bg", "custom_domain": true },
    { "pattern": "www.airsoftwarzone.bg", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/assets/video/*"]
  }
}
